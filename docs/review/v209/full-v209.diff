+    /// "X" → "X 2" → "X 3"… (an unused name is returned unchanged).
+    static func uniqueDisplayName(for name: String, taken: [String]) -> String {
+        let taken = Set(taken.map { $0.lowercased() })
+        if !taken.contains(name.lowercased()) { return name }
